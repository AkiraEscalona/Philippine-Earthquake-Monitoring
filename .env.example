# Copy to .env (cp / Copy-Item .env.example .env). Never commit .env.

# --- Source: GarbinWx (PHIVOLCS data, CC BY-SA 4.0). Free for NON-COMMERCIAL use. ---
GARBINWX_URL=https://data.garbinwx.org/api/earthquakes.json
# Identify yourself so the operator can contact you; put a real contact here.
USER_AGENT=PhilippineEarthquakeMonitoring/1.0 (student project; contact: you@example.com)
# Seconds between API polls. Values below 60 are raised to 60. 300 = every 5 minutes.
POLL_INTERVAL_SECONDS=300
REQUEST_TIMEOUT_SECONDS=20
MAX_BACKOFF_SECONDS=900
PRODUCER_STATE_PATH=.state/producer_seen.json

# --- Kafka (host-side address; containers use kafka:9092 internally) ---
KAFKA_BOOTSTRAP_SERVERS=localhost:29092
KAFKA_TOPIC=philippine-earthquakes

# --- MongoDB (local, no authentication, bound to 127.0.0.1) ---
MONGO_URI=mongodb://localhost:27017
MONGO_DB=earthquake_monitor

# --- Dashboard ---
DASHBOARD_REFRESH_SECONDS=15
